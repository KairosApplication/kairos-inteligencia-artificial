GROQ_API_KEY=
OPENAI_API_KEY=

# Regras de negócio e limites ajustáveis das consultas.
ESTOQUE_LIMITE_CRITICO=0.2
ESTOQUE_LIMITE_BAIXO=0.5
LIMITE_PADRAO_RESULTADOS=20
LIMITE_MAXIMO_RESULTADOS=50
LIMITE_PADRAO_RECOMENDACOES=10
HISTORICO_VENDAS_MAX_DIAS=365
HISTORICO_CLIENTES_MAX_DIAS=730
TENDENCIA_MAX_SEMANAS=52
PREVISAO_MAX_SEMANAS=12

POSTGRESQL_HOST=
POSTGRESQL_DB=
POSTGRESQL_PORT=
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=

MONGODB_URI=
MONGODB_DATABASE=

# Opcional: integra a persistência com kairos-api-ia; mongodb preserva o console atual.
PERSISTENCE_BACKEND=mongodb
AI_API_URL=
AI_API_TOKEN=
# Token exclusivo da API Python, usado apenas pelo backend confiável.
CHATBOT_SERVICE_TOKEN=

# Login existente: sessão Spring no desktop; Firebase Admin com credenciais no servidor.
SPRING_AUTH_URL=http://localhost:8080
SPRING_SESSION_COOKIE_NAME=JSESSIONID
CHAT_ALLOWED_ORIGINS=["http://localhost:5173"]
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS: caminho externo ao repositório para as credenciais Admin.

# Observabilidade opcional.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
