GROQ_API_KEY=
OPENAI_API_KEY=

POSTGRESQL_HOST=
POSTGRESQL_DB=
POSTGRESQL_PORT=
POSTGRESQL_USER=
POSTGRESQL_PASSWORD=

MONGODB_URI=
MONGODB_DATABASE=

# Opcional: integra a persistência com kairos-api-ia; mongodb preserva o console atual.
PERSISTENCE_BACKEND=mongodb
AI_API_URL=
AI_API_TOKEN=
# Token exclusivo da API Python, usado apenas pelo backend confiável.
CHATBOT_SERVICE_TOKEN=

# Login existente: sessão Spring no desktop; Firebase Admin com credenciais no servidor.
SPRING_AUTH_URL=http://localhost:8080
SPRING_SESSION_COOKIE_NAME=JSESSIONID
CHAT_ALLOWED_ORIGINS=["http://localhost:5173"]
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS: caminho externo ao repositório para as credenciais Admin.

# Observabilidade opcional.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Databricks: OAuth M2M. HOST deve conter apenas https://<workspace>, sem caminho ou ?o=.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_OAUTH_SCOPES=sql unity-catalog
SQL_WAREHOUSE_ID=
# Referências completas catalog.schema.indicador, mantidas somente no ambiente.
DAILY_SALES=
SALES_BY_CATEGORY=
STOCK_BY_PRODUCT=
STOCKOUT_SUMMARY=
REPLENISHMENT_SUMMARY=
OPERATIONS_SUMMARY=
# Opcional: metadados do dashboard exigem também o escopo dashboards.
DASHBOARD_LINK=
# Por padrão todas as consultas exigem esta coluna e filtram a empresa autenticada.
DATABRICKS_COMPANY_COLUMN=company_id
# Somente se TODO o conjunto configurado representar exclusivamente uma empresa:
# DATABRICKS_COMPANY_ID=<ID confirmado da empresa no backend>

# MCP e A2A iniciam junto com a aplicação; não precisam de outro comando/porta.
# Opcional, SOMENTE se o analista for implantado em outro serviço:
# ANALYST_A2A_URL=https://<servico-do-analista>/a2a/analyst
# Segredo exclusivo do backend (>=32 caracteres). Nunca enviar ao frontend/mobile.
ANALYST_A2A_TOKEN=
